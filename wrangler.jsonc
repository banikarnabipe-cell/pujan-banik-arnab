{
  // Cloudflare Workers (static assets) — deployment target for the portfolio.
  // Validated with `wrangler deploy --dry-run`; deploy with `pnpm deploy`.
  // Secrets: none required (fully static site) — never add tokens here.
  // NOTE: `name` MUST equal the Git-connected Worker on Cloudflare
  // (Workers Builds integration). Renaming here without renaming the
  // connected Worker breaks the Cloudflare CI check with
  // "This Worker does not exist on your account".
  "name": "pujan-banik-arnab",
  "compatibility_date": "2026-10-01",
  // Self-build before every deploy: Workers Builds' default pipeline has a
  // blank build command, so `npx wrangler deploy` must produce ./apps/web/dist
  // itself (monorepo: design-system tokens → web). Runs for manual deploys,
  // wrangler dry-runs, and the Cloudflare Git integration alike.
  "build": {
    "command": "pnpm -r build",
    "cwd": ".",
  },
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "none",
  },
  // This Worker ships STATIC ASSETS ONLY - there is no Worker code, no
  // bindings, no routes and no custom domain. Cloudflare rejects a deploy
  // that tries to attach Workers Logs / Tail Workers to such a Worker
  // ("Logpush cannot be added to a Worker that only has static assets"),
  // and wrangler v4 enables observability by default. Turning it off keeps
  // the deployment payload valid for an assets-only Worker.
  "observability": {
    "enabled": false,
  },
  // Previews: Cloudflare's branch-oriented preview workflow. The block is
  // REQUIRED for `wrangler preview` (and therefore for the Workers Builds
  // preview builds that run on every pull request). This Worker has no
  // preview-specific variables or bindings, so it is empty.
  // (The old `env.preview` block is gone: it named a Worker that does not
  // exist on the account and nothing deployed to it. `pnpm deploy:preview`
  // publishes a branch Preview instead.)
  "previews": {},
}

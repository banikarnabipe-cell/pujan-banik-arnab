---
interface Props {
  readonly lines: readonly string[];
  readonly id?: string;
}

const { lines, id } = Astro.props;
---

<h2 class="h2" id={id} data-reveal>
  {lines.map((line) => <span class="line">{line}</span>)}
</h2>

<style>
  .h2 {
    font-size: var(--md-sys-type-headline-large-size);
    font-weight: var(--md-sys-type-headline-large-weight);
    line-height: var(--md-sys-type-headline-large-line-height);
    letter-spacing: var(--md-sys-type-headline-large-tracking);
    text-wrap: balance;
    max-width: 24ch;
  }
  .line { display: block; }
</style>

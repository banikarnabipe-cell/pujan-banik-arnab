---
import Heading from "./Heading.astro";
import { site } from "../data/site";

const { credentials } = site.scenes;
---

<Heading lines={credentials.title} />

<div class="groups">
  {credentials.groups.map((group, idx) => (
    <article
      class:list={["group", "m3-card", { "group--featured": group.featured, "m3-card--filled": group.featured }]}
      data-reveal
      style={`--reveal-order: ${idx + 1}`}
      aria-labelledby={`group-${group.name.toLowerCase()}`}
    >
      <div class="group-head">
        <h3 id={`group-${group.name.toLowerCase()}`}>{group.name}</h3>
        {group.year && <span class="microlabel year">{group.year}</span>}
      </div>
      {group.note && <p class="note">{group.note}</p>}
      <ul role="list">
        {group.items.map((item) => (
          <li>{item.text}</li>
        ))}
      </ul>
      <div class="actions">
        {group.actions.map((action) => (
          <a class={`btn btn--${action.variant}`} href={action.href}>{action.label}</a>
        ))}
      </div>
    </article>
  ))}
</div>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: clamp(2rem, 1.2rem + 3vw, 3rem);
    align-items: start;
  }
  .group {
    display: grid;
    gap: 16px;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }
  .group--featured {
    background: var(--md-sys-color-surface-container-high);
  }
  .group-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .group h3 {
    font-size: var(--md-sys-type-title-large-size);
    font-weight: var(--md-sys-type-title-large-weight);
    letter-spacing: var(--md-sys-type-title-large-tracking);
  }
  .note {
    font-size: var(--md-sys-type-body-medium-size);
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.55;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  li {
    position: relative;
    padding-left: 18px;
    font-size: var(--md-sys-type-body-medium-size);
    line-height: 1.55;
  }
  li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--md-sys-color-primary);
    opacity: 0.85;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }
  @media (max-width: 768px) {
    .groups { grid-template-columns: 1fr; }
  }
</style>

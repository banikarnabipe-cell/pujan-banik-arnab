# Security headers for Cloudflare Workers static assets.
# Served verbatim from the asset directory root (dist/_headers).
# NOTE: script-src pins the sha256 of EVERY inline script in the built page.
# Astro auto-inlines small processed <script> blocks, so any inline script
# that is not pinned here is silently blocked on the edge (v0.7.1 incident:
# reveal observer never ran, all [data-reveal] content invisible). After ANY
# change that could touch inline scripts, recompute and self-verify:
#   pnpm build && node tooling/scripts/csp-hash.mjs
# CI enforces consistency with tooling/scripts/verify-csp.mjs. Style-src keeps 'unsafe-inline' (Astro scoped-style
# injection); everything else is locked to 'self'.

/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-WZRJfWvsnNCPcxzZwvyhovnZGqhZaC+8gPGPRbx6wTk='; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

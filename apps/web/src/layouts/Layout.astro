---
import "@pba/design-system/tokens.css";
import "../styles/tailwind.css";
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  readonly title?: string;
  readonly description?: string;
}

const { title = `${site.brand.name} — ${site.brand.tagline}`, description = site.hero.lede } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ececec" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1e1e1e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <!-- Reveal-on-enter observer. EXTERNAL file (public/reveal.js): Astro
         auto-inlines small processed scripts, and inline scripts must be
         sha256-pinned by the CSP in public/_headers — an unpinned inline
         script is blocked on the edge and leaves [data-reveal] content
         permanently invisible (v0.7.1 regression, see docs/HANDOFF.md). -->
    <script is:inline src="/reveal.js" defer></script>
  </body>
</html>
